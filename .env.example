# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=smartgym
POSTGRES_USER=smartgym
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# ─── Redis ────────────────────────────────────────────────────
REDIS_PORT=6379

# ─── MQTT ─────────────────────────────────────────────────────
MQTT_PORT=1883
MQTT_WS_PORT=9001

# ─── Spring Boot API ──────────────────────────────────────────
API_PORT=8080
JWT_SECRET=change-this-to-a-very-long-random-secret-in-production
JWT_EXPIRATION_MS=86400000

# ─── Recognition Service ──────────────────────────────────────
RECOGNITION_SERVICE_PORT=8090
RECOGNITION_SERVICE_URL=http://localhost:8090

# ─── Prometheus / Grafana ────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
